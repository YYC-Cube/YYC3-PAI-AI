# NAS 远程曲库模式：构建时指定 yyc3-music-api 地址，前端不再打包本地音频（112MB→0）
# 用法: cp .env.nas.example .env.local && pnpm build
#
# 公网入口（推荐，HTTPS 正式证书，2026-10-29 已上线）:
VITE_MUSIC_API_BASE=https://music.0379.world

# 曲源: NAS yyc3-music-api (network_mode host, 端口 3113, 曲库 /Volume1/yyc3_hd/Music)
# 链路: Traefik(ECS 39.97.53.176) → Tailscale → nas-nginx(CORS+Range) → music-api

# 家庭内网直连:
# VITE_MUSIC_API_BASE=http://192.168.3.45:3113

# Tailscale:
# VITE_MUSIC_API_BASE=http://100.65.172.88:3113
